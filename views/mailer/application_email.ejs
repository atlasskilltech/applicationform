<% var d = details || {}; %>
<div style="font-family:Arial,Helvetica,sans-serif;max-width:640px;margin:0 auto;color:#1f2937">
  <div style="background:#4f46e5;color:#fff;padding:20px 24px;border-radius:12px 12px 0 0">
    <h2 style="margin:0;font-size:18px">ATLAS SkillTech University</h2>
    <p style="margin:4px 0 0;font-size:13px;opacity:.9">Application received</p>
  </div>
  <div style="border:1px solid #e5e7eb;border-top:0;padding:24px;border-radius:0 0 12px 12px">
    <p>Dear <strong><%= d.name || 'Applicant' %></strong>,</p>
    <p>Thank you for applying to ATLAS SkillTech University. We have received your application
      <% if (d.applnID) { %>(Application ID: <strong><%= d.applnID %></strong>)<% } %>
      for <strong><%= d.school_name || '' %></strong><% if (d.specialisation_name) { %> — <%= d.specialisation_name %><% } %>.</p>
    <p>Your completed application form is attached as a PDF for your records. Our admissions team
      will be in touch regarding the next steps, including the application fee.</p>
    <p style="margin-top:24px">Warm regards,<br/>Admissions Team<br/>ATLAS SkillTech University</p>
  </div>
</div>
