<script src="<%= baseUrl %>assets/new-assets/js/jquery.js"></script>

<!-- ---- UI behaviour: theme toggle, "on this page" rail, dropzones, custom dropdowns, icons ---- -->
<script>
  (function () {
    'use strict';

    // ---------- Theme toggle ----------
    function applyTheme(theme) {
      var dark = theme === 'dark';
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    }
    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
        applyTheme(next);
        try { localStorage.setItem('atlas-theme', next); } catch (_) {}
      });
    });
    window.addEventListener('storage', function (e) {
      if (e.key === 'atlas-theme' && (e.newValue === 'light' || e.newValue === 'dark')) applyTheme(e.newValue);
    });

    // ---------- "On this page" rail: smooth scroll + scrollspy ----------
    var HEADER_OFFSET = 96;
    var root = document.documentElement;
    var tocLinks = Array.prototype.slice.call(document.querySelectorAll('[data-toc]'));
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function setActive(id) {
      tocLinks.forEach(function (link) {
        link.setAttribute('data-active', link.getAttribute('data-toc') === id ? 'true' : 'false');
      });
    }

    var animId = null;
    var pendingId = null;

    function easeOutQuart(t) { return 1 - Math.pow(1 - t, 4); }

    function cancelAnim() {
      if (animId !== null) { cancelAnimationFrame(animId); animId = null; }
      root.style.scrollBehavior = '';
    }

    function releaseToUser() { cancelAnim(); pendingId = null; syncSpy(); }

    var animStartedAt = 0;

    function animateScrollTo(targetY, done) {
      cancelAnim();
      var maxY = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight) - window.innerHeight;
      targetY = Math.max(0, Math.min(targetY, maxY));
      var startY = window.pageYOffset;
      var delta = targetY - startY;

      if (Math.abs(delta) < 2 || reduceMotion.matches) {
        window.scrollTo(0, targetY);
        if (done) done();
        return;
      }

      var duration = Math.min(700, Math.max(300, Math.abs(delta) * 0.4));
      var startTime = null;
      root.style.scrollBehavior = 'auto';
      animStartedAt = performance.now();

      function frame(now) {
        if (startTime === null) startTime = now;
        var p = Math.min(1, (now - startTime) / duration);
        window.scrollTo(0, startY + delta * easeOutQuart(p));
        if (p < 1) { animId = requestAnimationFrame(frame); }
        else { window.scrollTo(0, targetY); animId = null; root.style.scrollBehavior = ''; if (done) done(); }
      }
      animId = requestAnimationFrame(frame);
    }

    function goToSection(id) {
      var target = document.getElementById(id);
      if (!target) return;
      pendingId = id;
      setActive(id);
      var y = target.getBoundingClientRect().top + window.pageYOffset - HEADER_OFFSET;
      animateScrollTo(y, function () { setActive(id); pendingId = null; });
    }

    tocLinks.forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        goToSection(link.getAttribute('data-toc'));
      });
    });

    document.querySelectorAll('a[href="#stud-info"]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        goToSection('stud-info');
      });
    });

    var SCROLL_KEYS = { ArrowUp: 1, ArrowDown: 1, PageUp: 1, PageDown: 1, Home: 1, End: 1, ' ': 1, Spacebar: 1 };
    var ABORT_GRACE = 180;

    function maybeRelease(isIntentional) {
      if (animId === null) return;
      if (!isIntentional) return;
      if (performance.now() - animStartedAt < ABORT_GRACE) return;
      releaseToUser();
    }

    window.addEventListener('wheel', function (e) { maybeRelease(Math.abs(e.deltaY) > 0 || Math.abs(e.deltaX) > 0); }, { passive: true });
    window.addEventListener('touchstart', function () { maybeRelease(true); }, { passive: true });
    window.addEventListener('keydown', function (e) { maybeRelease(!!SCROLL_KEYS[e.key]); }, { passive: true });

    var ticking = false;

    function syncSpy() {
      if (pendingId) return;
      var probe = HEADER_OFFSET + 24;
      var currentId = tocLinks.length ? tocLinks[0].getAttribute('data-toc') : null;

      tocLinks.forEach(function (link) {
        var section = document.getElementById(link.getAttribute('data-toc'));
        if (!section || section.offsetParent === null) return;
        if (section.getBoundingClientRect().top <= probe) currentId = link.getAttribute('data-toc');
      });

      var atBottom = window.innerHeight + window.pageYOffset >=
        Math.max(document.body.scrollHeight, document.documentElement.scrollHeight) - 4;
      if (atBottom && tocLinks.length) currentId = tocLinks[tocLinks.length - 1].getAttribute('data-toc');

      if (currentId) setActive(currentId);
    }

    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { syncSpy(); ticking = false; });
    }, { passive: true });

    window.addEventListener('resize', syncSpy, { passive: true });
    syncSpy();

    // ---------- Section completion tracker ----------
    (function () {
      var form = document.querySelector('form[name="ug-"]');
      if (!form) return;

      var GROUPS = {
        'stud-info': ['stud-info'],
        'personal-info': ['personal-info'],
        'educ-info': ['educ-info'],
        'parent-info': ['parent-info', 'sla'],
        'submit-info': ['submit-info']
      };

      var MARKER = '.form-label, .required, [data-req]';
      var CONTROL = 'input[name], select[name], textarea[name]';

      var bar = document.getElementById('toc-progress-bar');
      var text = document.getElementById('toc-progress-text');

      function onScreen(el) { return !!el && el.getClientRects().length > 0; }

      function filled(el) {
        if (el.type === 'checkbox' || el.type === 'radio') return el.checked;
        if (el.type === 'file') return !!(el.files && el.files.length) || !!el.value;
        return String(el.value == null ? '' : el.value).trim() !== '';
      }

      function scan(section) {
        var owner = null;
        var required = [];

        Array.prototype.forEach.call(
          section.querySelectorAll(MARKER + ', ' + CONTROL),
          function (node) {
            if (node.matches(MARKER)) {
              owner = node.classList.contains('required') || node.hasAttribute('data-req') ? [] : null;
              if (owner) required.push(owner);
              return;
            }
            if (!owner) return;
            if (node.type === 'hidden' || node.disabled || !onScreen(node)) return;
            owner.push(node);
          }
        );

        var total = 0, done = 0;
        required.forEach(function (group) {
          var counted = {};
          group.forEach(function (el) {
            if (el.type === 'radio' || el.type === 'checkbox') {
              if (counted[el.name]) return;
              counted[el.name] = true;
              total++;
              var any = group.some(function (o) { return o.name === el.name && o.checked; });
              if (any) done++;
            } else {
              total++;
              if (filled(el)) done++;
            }
          });
        });

        return { total: total, done: done };
      }

      function update() {
        var sectionsDone = 0;

        tocLinks.forEach(function (link) {
          var total = 0, done = 0;
          (GROUPS[link.getAttribute('data-toc')] || []).forEach(function (id) {
            var section = document.getElementById(id);
            if (!onScreen(section)) return;
            var count = scan(section);
            total += count.total;
            done += count.done;
          });

          var complete = total > 0 && done === total;
          link.setAttribute('data-complete', complete ? 'true' : 'false');
          var noun = total === 1 ? ' required field' : ' required fields';
          link.title = complete ? 'Complete — all ' + total + noun + ' filled in'
            : done + ' of ' + total + noun + ' filled in';
          if (complete) sectionsDone++;
        });

        var pct = tocLinks.length ? Math.round(sectionsDone / tocLinks.length * 100) : 0;
        if (bar) bar.style.width = pct + '%';
        if (text) {
          text.textContent = sectionsDone + ' of ' + tocLinks.length + ' done';
          text.classList.toggle('is-done', sectionsDone === tocLinks.length);
        }
      }

      var queued = null;
      function schedule() {
        if (queued !== null) return;
        queued = requestAnimationFrame(function () { queued = null; update(); });
      }

      form.addEventListener('input', schedule);
      form.addEventListener('change', schedule);

      new MutationObserver(function (records) {
        for (var i = 0; i < records.length; i++) {
          if (!records[i].target.closest('.ui-select__panel')) return schedule();
        }
      }).observe(form, {
        childList: true, subtree: true, attributes: true,
        attributeFilter: ['style', 'class', 'disabled', 'value']
      });

      update();
      window.addEventListener('load', schedule);
    })();

    // ---------- Dropzones ----------
    document.querySelectorAll('label[for] > input[type="file"]').forEach(function (input) {
      var zone = input.parentElement;
      var note = zone.querySelector('[data-file-name]');

      function showFile(file) {
        if (!note) return;
        if (file) {
          note.textContent = file.name + ' · ' + (file.size / 1024).toFixed(1) + ' KB selected';
          note.classList.remove('hidden');
        } else {
          note.textContent = '';
          note.classList.add('hidden');
        }
      }

      input.addEventListener('change', function () { showFile(input.files && input.files[0]); });

      zone.addEventListener('dragover', function (e) {
        e.preventDefault();
        zone.classList.add('border-indigo-500', 'bg-indigo-50/40', 'dark:bg-indigo-500/10');
      });
      zone.addEventListener('dragleave', function () {
        zone.classList.remove('border-indigo-500', 'bg-indigo-50/40', 'dark:bg-indigo-500/10');
      });
      zone.addEventListener('drop', function (e) {
        e.preventDefault();
        zone.classList.remove('border-indigo-500', 'bg-indigo-50/40', 'dark:bg-indigo-500/10');
        var file = e.dataTransfer.files[0];
        if (!file) return;
        var dt = new DataTransfer();
        dt.items.add(file);
        input.files = dt.files;
        showFile(file);
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });

    // ---------- Custom dropdowns ----------
    (function () {
      var CHEV = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>';
      var SEARCH_THRESHOLD = 12;
      var open = null;
      var IS_TOUCH = !!(window.matchMedia && window.matchMedia('(hover: none), (pointer: coarse)').matches); 

      function enhance(select) {
        if (select.multiple || select.dataset.uiSelect) return;
        select.dataset.uiSelect = '1';

        var wrap = document.createElement('div');
        wrap.className = 'ui-select';
        select.parentNode.insertBefore(wrap, select);
        wrap.appendChild(select);
        select.classList.add('ui-select__native');
        select.setAttribute('tabindex', '-1');

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ui-select__btn';
        btn.setAttribute('aria-haspopup', 'listbox');
        btn.setAttribute('aria-expanded', 'false');
        btn.innerHTML = '<span class="ui-select__value"></span><span class="ui-select__chev">' + CHEV + '</span>';

        var panel = document.createElement('div');
        panel.className = 'ui-select__panel';

        var searchWrap = document.createElement('div');
        searchWrap.className = 'ui-select__search';
        var search = document.createElement('input');
        search.type = 'text';
        search.placeholder = 'Search…';
        search.setAttribute('autocomplete', 'off');
        searchWrap.appendChild(search);

        var list = document.createElement('ul');
        list.className = 'ui-select__list';
        list.setAttribute('role', 'listbox');

        var empty = document.createElement('div');
        empty.className = 'ui-select__empty';
        empty.textContent = 'No matches';
        empty.style.display = 'none';

        panel.appendChild(searchWrap);
        panel.appendChild(list);
        panel.appendChild(empty);
        wrap.appendChild(btn);
        wrap.appendChild(panel);

        var valueEl = btn.querySelector('.ui-select__value');
        var activeIndex = -1;

        function realOptions() {
          return Array.prototype.filter.call(select.options, function (o) { return o.value !== ''; });
        }

        function syncButton() {
          var opt = select.options[select.selectedIndex];
          var isPlaceholder = !opt || opt.value === '';
          valueEl.textContent = opt ? opt.text : 'Please select';
          btn.classList.toggle('is-placeholder', isPlaceholder);
          btn.disabled = select.disabled;
        }

        function buildList(filter) {
          var q = (filter || '').trim().toLowerCase();
          list.innerHTML = '';
          var shown = 0;

          realOptions().forEach(function (opt) {
            if (q && opt.text.toLowerCase().indexOf(q) === -1) return;
            var li = document.createElement('li');
            li.className = 'ui-select__opt';
            li.setAttribute('role', 'option');
            li.dataset.value = opt.value;
            if (opt.disabled) li.classList.add('is-disabled');
            if (opt.selected) { li.classList.add('is-selected'); li.setAttribute('aria-selected', 'true'); }
            li.textContent = opt.text;
            list.appendChild(li);
            shown++;
          });

          empty.style.display = shown ? 'none' : 'block';
          searchWrap.style.display = realOptions().length > SEARCH_THRESHOLD ? '' : 'none';
          activeIndex = -1;
        }

        function rows() {
          return Array.prototype.filter.call(list.children, function (li) { return !li.classList.contains('is-disabled'); });
        }

        function setActive(i, scroll) {
          var all = rows();
          all.forEach(function (li) { li.classList.remove('is-active'); });
          if (i < 0 || i >= all.length) { activeIndex = -1; return; }
          activeIndex = i;
          all[i].classList.add('is-active');
          if (scroll) all[i].scrollIntoView({ block: 'nearest' });
        }

        function openPanel() {
          if (open && open !== closePanel) open();
          buildList('');
          search.value = '';

          wrap.classList.remove('is-up', 'is-right');
          wrap.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          open = closePanel;

          var r = btn.getBoundingClientRect();
          var height = panel.offsetHeight;
          var below = window.innerHeight - r.bottom;
          if (below < height + 16 && r.top >= height + 16) wrap.classList.add('is-up');
          var host = wrap.closest('form');
          var limit = window.innerWidth - 12;
          if (host) limit = Math.min(limit, host.getBoundingClientRect().right);
          if (r.left + panel.offsetWidth > limit) wrap.classList.add('is-right');

          var all = rows();
          var sel = -1;
          for (var i = 0; i < all.length; i++) {
            if (all[i].classList.contains('is-selected')) { sel = i; break; }
          }
          setActive(sel);
          // Not on touch: focusing this raises the on-screen keyboard, whose resize
          // event then closed the panel the instant it opened.
          if (!IS_TOUCH && searchWrap.style.display !== 'none') search.focus();
        }

        function closePanel() {
          wrap.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          if (open === closePanel) open = null;
        }

        function choose(li) {
          if (!li || li.classList.contains('is-disabled')) return;
          var value = li.dataset.value;
          if (select.value !== value) {
            select.value = value;
            syncButton();
            select.dispatchEvent(new Event('change', { bubbles: true }));
          }
          closePanel();
          btn.focus();
        }

        btn.addEventListener('click', function () {
          if (select.disabled) return;
          wrap.classList.contains('is-open') ? closePanel() : openPanel();
        });

        btn.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPanel(); }
        });

        list.addEventListener('click', function (e) {
          var li = e.target.closest('.ui-select__opt');
          if (li) choose(li);
        });

        list.addEventListener('mousemove', function (e) {
          var li = e.target.closest('.ui-select__opt');
          if (li) setActive(rows().indexOf(li));
        });

        search.addEventListener('input', function () {
          buildList(search.value);
          setActive(rows().length ? 0 : -1);
        });

        panel.addEventListener('keydown', function (e) {
          var all = rows();
          if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(activeIndex + 1, all.length - 1), true); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(Math.max(activeIndex - 1, 0), true); }
          else if (e.key === 'Home') { e.preventDefault(); setActive(0, true); }
          else if (e.key === 'End') { e.preventDefault(); setActive(all.length - 1, true); }
          else if (e.key === 'Enter') { e.preventDefault(); choose(all[activeIndex]); }
          else if (e.key === 'Escape' || e.key === 'Tab') { closePanel(); if (e.key === 'Escape') btn.focus(); }
        });

        document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) closePanel(); });
        // Only a WIDTH change dismisses. A phone fires resize for the on-screen
        // keyboard and the collapsing URL bar too, but those change the height only.
        var lastWidth = window.innerWidth;
        window.addEventListener('resize', function () {
          if (window.innerWidth === lastWidth) return;
          lastWidth = window.innerWidth;
          closePanel();
        }, { passive: true });

        new MutationObserver(function () {
          syncButton();
          if (wrap.classList.contains('is-open')) buildList(search.value);
        }).observe(select, { childList: true, subtree: true, attributes: true, attributeFilter: ['disabled'] });

        select.addEventListener('change', syncButton);

        syncButton();
        buildList('');
      }

      document.querySelectorAll('select.form-select').forEach(enhance);
    })();

    if (window.lucide) window.lucide.createIcons();
  })();
</script>

