<script>
(function () {
  'use strict';
  // Same-origin: the session tracker now runs in this Node app (routes/tracker.js),
  // so there is no cross-origin call and no CORS involved.
  var BASE = '/';
  var KEY = 'atlas_track_token';
  var token = null;
  var currentStep = 'stud-info';
  var lastPayload = '';
  var reinitDone = false;
  var debounceTimer = null;

  // localStorage is shared by all tabs, so a new tab continues the same session
  function store(v) { try { v ? localStorage.setItem(KEY, v) : localStorage.removeItem(KEY); } catch (e) {} }
  function load()   { try { return localStorage.getItem(KEY); } catch (e) { return null; } }

  function post(url, data) {
    return fetch(BASE + 'tracker/' + url, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: new URLSearchParams(data).toString()
    }).then(function (r) { return r.json(); }).catch(function () { return null; });
  }

  // Only READS ?s=atlas-9462 if present. Never changes the URL.
  function init(skipCode) {
    var s = skipCode ? '' : (new URLSearchParams(location.search).get('s') || '');
    return post('init', { token: load() || '', s: s }).then(function (res) {
      if (!res || !res.token) return;
      token = res.token;
      store(token);
      if (res.current_step) currentStep = res.current_step;
    });
  }

  function gv(id) { var el = document.getElementById(id); return el ? el.value.trim() : ''; }

  function progress() {
    var bar = document.getElementById('toc-progress-bar');
    return bar ? (parseInt(bar.style.width) || 0) : 0;
  }

  function autosave(stepChanged) {
    if (!token) return;
    var payload = {
      token: token,
      first_name: gv('firstName'),
      last_name: gv('lastName'),
      mobile: gv('phone'),
      email: gv('email'),
      school_id: gv('school'),
      certification_id: gv('certification'),
      abbrivation_id: gv('abbrivation'),
      specialisation_id: gv('specialisation'),
      current_step: currentStep,
      progress_percent: progress(),
      step_changed: stepChanged ? 1 : 0
    };
    var sig = JSON.stringify(payload);
    if (!stepChanged && sig === lastPayload) return;
    lastPayload = sig;

    post('autosave', payload).then(function (res) {
      // Session was submitted/merged elsewhere -> get a valid one (once)
      if (res && res.ok === false && !reinitDone) {
        reinitDone = true;
        store(null);
        token = null;
        init(true);
      }
    });
  }

  function debouncedSave() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(function () { autosave(false); }, 1500);
  }

  function heartbeat() {
    if (token) post('heartbeat', { token: token, current_step: currentStep });
  }

  function watchSections() {
    var ids = ['stud-info', 'personal-info', 'educ-info', 'parent-info', 'submit-info'];
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting && e.target.id !== currentStep) {
          currentStep = e.target.id;
          autosave(true);
        }
      });
    }, { rootMargin: '-40% 0px -50% 0px' });
    ids.forEach(function (id) { var s = document.getElementById(id); if (s) io.observe(s); });
  }

  init().then(function () {
    watchSections();
    setInterval(function () { autosave(false); }, 15000); // auto-save every 15s
    setInterval(heartbeat, 30000);                       // heartbeat every 30s
    document.addEventListener('input', debouncedSave);
    document.addEventListener('change', debouncedSave);
  });

  // Call from your doAdmission2 success callback:
  //   if (window.atlasTrackSubmitted) window.atlasTrackSubmitted(response.application_id);
  window.atlasTrackSubmitted = function (appId) {
    if (token) post('submitted', { token: token, application_id: appId || '' });
    store(null);
    token = null;
  };
})();
</script>


<script>
// ===== Maths/Physics question text + compulsory note, keyed on abbrivation =====
(function () {
  'use strict';

  var abbr  = document.getElementById('abbrivation');
  var maths = document.getElementById('isPersuingUG');
  var label = document.getElementById('match-que');
  var note  = document.getElementById('maths-compulsory-note');
  if (!abbr || !maths || !label) return;

  // One entry per degree that requires subjects. `question` is the label text,
  // `subject` is the fragment inside the amber note.
  var RULES = {
    8:  { question: 'Have you studied or are you currently studying Mathematics in Grade 12 (or equivalent)?',
          subject:  'Mathematics is' },
    12: { question: 'Have you studied or are you currently studying Mathematics and Physics in Grade 12 (or equivalent)?',
          subject:  'Mathematics and Physics are' }
  };

  var DEFAULT_QUESTION = 'Have you studied or are you currently studying Mathematics in Grade 12 (or equivalent)?';

  var subjectEl = note ? note.querySelector('[data-note-subject]') : null;

  function sync() {
    var rule = RULES[parseInt(abbr.value, 10)];

    label.textContent = rule ? rule.question : DEFAULT_QUESTION;

    if (!note) return;
    var show = !!rule && maths.value === 'no';
    if (show && subjectEl) subjectEl.textContent = rule.subject;
    note.classList.toggle('hidden', !show);
    note.classList.toggle('flex', show);
  }

  sync();
  abbr.addEventListener('change', sync);
  maths.addEventListener('change', sync);

  // Degree options arrive via AJAX and can reset the value without a 'change'.
  new MutationObserver(sync).observe(abbr, { childList: true });

  if (window.lucide) window.lucide.createIcons();
})();
</script>

