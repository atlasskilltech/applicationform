              <!--      </select>-->
              <!--  </label>-->
                <% } %>
              
            <label class="block">
              <span class="form-label required">School</span>
              <select class="form-select" name="school" id="school" onChange="getCerticiate(this.value,'certification','certification')">
                <option selected disabled value=""> Please select</option>
                <% (schools || []).forEach(function(rows){ %>
                  <option value="<%- rows.school_id %>"><%- rows.school_full_name %></option>
                <% }); %>
              </select>
            </label>

            <label class="block">
              <span class="form-label required">Programs</span>
              <select class="form-select" name="certification" id="certification" onChange="getAbbrivationApp(this.value,'abbrivation','abbrivation')">
                <option selected disabled value="">Please select</option>
                <% (certification || []).forEach(function(rows){ %>
                  <!--<option value="<%- rows.certification_id %>"><%- rows.certification_name %></option>-->
                <% }); %>
              </select>
            </label>

            <label class="block">
              <span class="form-label required">Degree</span>
