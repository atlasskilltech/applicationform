<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ATLAS SkillTech University Application Form 2026-27</title>
  <meta name="description" content="Submit your online application quickly and securely; find eligibility, required documents, deadlines and steps for UG and PG admissions this intake." />
  <link rel="icon" type="image/png" href="https://atlasskilltech.app/applicationform-aug-07/assets/images/favicon-32x32.png" />

  <!-- Theme init — runs before any rendering to prevent FOUC -->
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('atlas-theme');
        var dark = saved === 'dark'; // Light Mode is the project-wide default
        if (dark) document.documentElement.classList.add('dark');
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      } catch (_) {}
    })();
  </script>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui'] },
          boxShadow: { glow: '0 30px 60px -20px rgba(79,70,229,0.45)' }
        }
      }
    };
  </script>
