                <option selected disabled value="">Please select</option>
                <% (abrivation || []).forEach(function(rows){ %>
                  <option value="<%- rows.id %>"><%- rows.abbrivation %></option>
                <% }); %>
              </select>
            </label>

            <div id="specialisation_non_bba" style="display:none;">
              <label class="block">
                <span class="form-label required" id="specialisationText">Specialisation</span>
                <select class="form-select" name="specialisation" id="specialisation">
                  <option selected disabled value="">Please select</option>
                  <% (specialisations || []).forEach(function(rows){ %>
                    <option value="<%- rows.specialisation_id %>"><%- rows.specialisation_name %></option>
                  <% }); %>
                </select>
              </label>
            </div>
            
            <div id="major_non_bba" style="display:none;">
              <label class="block">
                <span class="form-label required" id="specialisationText">Major</span>
                <select class="form-select" name="major" id="major">
                  <option selected disabled value="">Please select</option>
                    <option value="Marketing">Marketing</option>
                    <option value="Finance">Finance</option>
                    <option value="Business Analytics">Business Analytics</option>
                    <option value="Digital Branding & Advertising">Digital Branding & Advertising</option>
                    <option value="AI & Emerging Technologies">AI & Emerging Technologies</option>
                    <option value="Business Psychology">Business Psychology</option>
                    <option value="Undecided">Undecided</option>
                </select>
              </label>
            </div>
            
            <div id="minor_non_bba" style="display:none;">
              <label class="block">
                <span class="form-label required" id="specialisationText">Minor</span>
                <select class="form-select" name="minor" id="minor">
                  <option selected disabled value="">Please select</option>
                    <option value="Marketing">Marketing</option>
                    <option value="Finance">Finance</option>
                    <option value="Business Analytics">Business Analytics</option>
                    <option value="Digital Branding & Advertising">Digital Branding & Advertising</option>
                    <option value="AI & Emerging Technologies">AI & Emerging Technologies</option>
                    <option value="Business Psychology">Business Psychology</option>
                    <option value="Economics">Economics</option>
                    <option value="Entrepreneurship">Entrepreneurship</option>
                    <option value="Family Managed Business">Family Managed Business</option>
                    <option value="Undecided">Undecided</option>
                </select>
              </label>
            </div>

            <label class="block">
              <span class="form-label required">How Did You Hear About Us?</span>
              <select class="form-select" name="source" id="source">
                <option selected disabled value="">Please select</option>
                <option value="1">College Fair / School Visit</option>
                <option value="2">College Reference Guide</option>
                <option value="3">Counselor / Teacher / Coaching Centre</option>
                <option value="4">Email</option>
                <option value="5">Magazine / Newspaper Ad</option>
                <option value="6">Magazine / Newspaper Article</option>
                <option value="7">Online Advertisement</option>
                <option value="8">Search Engine</option>
                <option value="9">Social Media</option>
                <option value="10">Word of Mouth</option>
                <option value="11">Other </option>
              </select>
            </label>
          </div>

          <!-- Profile image dropzone -->
          <div>
            <span class="form-label required">Profile image</span>
            <label for="userfile" class="group flex cursor-pointer flex-col items-center gap-4 rounded-2xl border border-dashed border-slate-200 bg-slate-50/60 p-5 text-center transition-colors hover:border-indigo-400 hover:bg-indigo-50/40 dark:border-slate-700 dark:bg-slate-800/40 dark:hover:border-indigo-400 dark:hover:bg-indigo-500/10 sm:flex-row sm:text-left">
              <span class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-white shadow-sm transition-colors dark:bg-slate-800 dark:shadow-black/20">
                <i data-lucide="camera" class="h-6 w-6 text-slate-400 transition-colors group-hover:text-indigo-500 dark:text-slate-500"></i>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-medium text-slate-800 dark:text-slate-200">Choose image or <span class="text-indigo-600 dark:text-indigo-300">browse</span></span>
                <span class="mt-1 block text-xs leading-relaxed text-slate-500 dark:text-slate-400">A professional, plain-background photo. JPG, JPEG or PNG · max 5&nbsp;MB.</span>
                <span data-file-name class="mt-1.5 hidden text-xs font-semibold text-emerald-700 dark:text-emerald-300"></span>
              </span>
              <span class="shrink-0 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 shadow-sm transition-colors group-hover:border-indigo-300 group-hover:text-indigo-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">Browse</span>
              <input type="file" name="userfile" id="userfile" accept=".jpg,.jpeg,.png,image/*" onchange="uploadFile()" class="sr-only">
            </label>
          </div>
