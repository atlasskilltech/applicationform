              <span class="h-px flex-1 bg-slate-100 dark:bg-slate-800"></span>
            </div>

            <label class="block">
              <span class="form-label required">Address</span>
              <textarea name="address_un_1" id="address_un_1" class="form-control" rows="3" placeholder="House / flat no., street, locality, landmark" required></textarea>
            </label>

            <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
