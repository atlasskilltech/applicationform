                  <% (countries || []).forEach(function(rows){ %>
                    <option value="<%- rows.country_id %>"><%- rows.country_name %></option>
                  <% }); %>
                </select>
              </label>

              <label class="block">
                <span class="form-label required">State</span>
                <select class="form-select" name="state_un_1" id="state_un_1" onChange="getStateCityV2(this.value,'city','city_un_1')">
                  <option selected disabled value="">Please select</option>
                </select>
              </label>

              <label class="block">
                <span class="form-label required">City</span>
                <select class="form-select" name="city_un_1" id="city_un_1" onchange="get_state(this.value)">
                  <option selected disabled value="">Please select</option>
                </select>
              </label>

              <label class="block">
                <span class="form-label required">Pin code</span>
                <input type="text" inputmode="numeric" class="form-control" name="pin_code_1" id="pin_code_1" placeholder="400070">
