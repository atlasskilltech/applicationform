            <div class="flex items-center gap-2">
              <span class="rounded-md bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold text-slate-500 dark:bg-slate-800 dark:text-slate-400">02</span>
              <h2 class="truncate text-base font-semibold text-slate-900 dark:text-white">Student Details</h2>
            </div>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Your name, address and contact information</p>
          </div>
        </div>

        <div id="sec-personal" class="space-y-5 px-5 pb-5 pt-4 sm:px-6">

          <!-- Name -->
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <label class="block">
              <span class="form-label required">First name</span>
              <input type="text" name="firstName" id="firstName" class="form-control text-capitalize" placeholder="First name">
            </label>
            <label class="block">
              <span class="form-label">Middle name</span>
              <input type="text" name="middleName" id="middleName" class="form-control text-capitalize" placeholder="Middle name">
            </label>
            <label class="block">
              <span class="form-label required">Last name</span>
              <input type="text" name="lastName" id="lastName" class="form-control text-capitalize" placeholder="Last name">
            </label>
          </div>

          <!-- Address -->
          <div>
            <div class="mb-4 flex items-center gap-3">
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><i data-lucide="map-pin" class="h-3.5 w-3.5"></i></span>
