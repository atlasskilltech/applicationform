<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title : 'Error' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style> body { font-family: Inter, ui-sans-serif, system-ui; } </style>
</head>
<body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col items-center justify-center px-4 text-center">
    <span class="grid h-16 w-16 place-items-center rounded-2xl bg-rose-100 text-rose-600">
      <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/><circle cx="12" cy="12" r="10"/></svg>
    </span>
    <h1 class="mt-6 text-2xl font-semibold tracking-tight text-slate-900"><%= typeof title !== 'undefined' ? title : 'Error' %></h1>
    <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-600"><%= typeof message !== 'undefined' ? message : 'Something went wrong. Please try again.' %></p>
    <a href="/" class="mt-8 inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50">Back to the form</a>
  </main>
</body>
</html>
