<% var d = details || {};
   function v(x){ return (x === null || x === undefined || x === '') ? '—' : x; } %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <style>
    * { box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; color: #111827; font-size: 12px; margin: 24px; }
    h1 { font-size: 18px; margin: 0 0 2px; }
    .muted { color: #6b7280; font-size: 11px; }
    .section { margin-top: 18px; }
    .section h2 { font-size: 13px; background: #4f46e5; color: #fff; padding: 6px 10px; border-radius: 6px; margin: 0 0 8px; }
    table { width: 100%; border-collapse: collapse; }
    td { padding: 5px 8px; vertical-align: top; border-bottom: 1px solid #eef2f7; }
    td.k { width: 34%; color: #6b7280; }
    td.val { font-weight: 600; }
  </style>
</head>
<body>
  <h1>ATLAS SkillTech University — Application</h1>
  <div class="muted">Application ID: <%= v(d.applnID) %><% if (d.school_name) { %> · <%= d.school_name %><% } %><% if (d.specialisation_name) { %> · <%= d.specialisation_name %><% } %></div>

  <div class="section">
    <h2>Student</h2>
    <table>
      <tr><td class="k">Name</td><td class="val"><%= v(d.name) %></td></tr>
      <tr><td class="k">Email</td><td class="val"><%= v(d.email) %></td></tr>
      <tr><td class="k">Mobile</td><td class="val"><%= v(d.phone) %></td></tr>
      <tr><td class="k">Date of birth</td><td class="val"><%= v(d.appln_dob) %></td></tr>
      <tr><td class="k">Gender</td><td class="val"><%= v(d.gender_name) %></td></tr>
      <tr><td class="k">Blood group</td><td class="val"><%= v(d.blood_name) %></td></tr>
      <tr><td class="k">Address</td><td class="val"><%= v(d.address) %><% if (d.city_name || d.state_name || d.country_name) { %>, <%= [d.city_name, d.state_name, d.country_name].filter(Boolean).join(', ') %><% } %> <%= v(d.appln_pincode) %></td></tr>
    </table>
  </div>

  <div class="section">
    <h2>Education</h2>
    <table>
      <tr><td class="k">Class X school</td><td class="val"><%= v(d.appln_institutionNameHS) %></td></tr>
      <tr><td class="k">Class X board / year</td><td class="val"><%= v(d.exam_board_nameHS) %> · <%= v(d.academic_year_nameHS) %></td></tr>
      <tr><td class="k">Class X marks</td><td class="val"><%= v(d.appln_marksSecuredHS) %><% if (d.appln_marksSecuredOutOfHS) { %> / <%= d.appln_marksSecuredOutOfHS %><% } %></td></tr>
      <tr><td class="k">Class XII school</td><td class="val"><%= v(d.appln_institutionNameHSS) %></td></tr>
      <tr><td class="k">Class XII board / year</td><td class="val"><%= v(d.exam_board_nameHSS) %> · <%= v(d.academic_year_nameHSS) %></td></tr>
    </table>
  </div>

  <div class="section">
    <h2>Parents</h2>
    <table>
      <tr><td class="k">Father</td><td class="val"><%= v(d.fatherFirstName) %> <%= v(d.fatherLastName) %> · <%= v(d.appln_fatherPhone) %> · <%= v(d.appln_fatherEmail) %></td></tr>
      <tr><td class="k">Mother</td><td class="val"><%= v(d.appln_motherFirstName) %> <%= v(d.appln_motherLastName) %> · <%= v(d.appln_motherPhone) %> · <%= v(d.appln_motherEmail) %></td></tr>
    </table>
  </div>

  <% if (d.appln_refExtraCurriculam) { %>
  <div class="section">
    <h2>Statement of purpose</h2>
    <p><%= d.appln_refExtraCurriculam %></p>
  </div>
  <% } %>
</body>
</html>
