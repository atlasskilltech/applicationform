# Copy this file to .env and fill in values for YOUR environment.
# .env is git-ignored and must never be committed. Keep real secrets out of
# source control — supply them via environment variables or a secret manager.

# ================= Server =================
PORT=3000
NODE_ENV=development
# Base URL for the static assets referenced by the view (logos, images, scripts).
BASE_ASSET_URL=https://example.com/assets/
# Strong, random session-cookie signing secret (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me

# ================= Databases =================
# Two connection groups are supported (primary + secondary). Point each at
# your own MySQL instance and credentials.
DICEAPP_DB_HOST=localhost
DICEAPP_DB_PORT=3306
DICEAPP_DB_USER=
DICEAPP_DB_PASSWORD=
DICEAPP_DB_NAME=
DICEAPP_DB_CONNECTION_LIMIT=10

DEFAULT_DB_HOST=localhost
DEFAULT_DB_PORT=3306
DEFAULT_DB_USER=
DEFAULT_DB_PASSWORD=
DEFAULT_DB_NAME=
DEFAULT_DB_CONNECTION_LIMIT=10

# ================= Uploads =================
UPLOAD_DIR=uploads

# ================= Object storage (S3-compatible) =================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# ================= Email (SMTP) =================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SENDGRID_API_KEY=
# Optional alternate mailer endpoint and its auth, if used.
ERP_MAIL_URL=
ERP_MAIL_COOKIE=
# Path to the Chromium binary used to render the application PDF.
CHROMIUM_PATH=/usr/bin/chromium

# ================= SMS (optional) =================
MSG91_AUTHKEY=
MSG91_FLOW_ID=
MSG91_SENDER=

# ================= reCAPTCHA =================
# Enable (STRICT=1) in production to protect the public form from abuse.
RECAPTCHA_SECRET=
RECAPTCHA_STRICT=1
