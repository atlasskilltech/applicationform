# ================= Server =================
PORT=3000
NODE_ENV=development
# Absolute base used for the static assets referenced by the view (logos, hero
# images, jQuery, script.js). Leave as the production URL to render identically.
BASE_ASSET_URL=https://www.atlasuniversity.edu.in/applicationform/
# Session cookie signing secret.
SESSION_SECRET=change-me

# ================= Databases =================
# TWO groups, mirroring the old CodeIgniter config:
#   DICEAPP_* -> primary admissions DB (all reads + master isdi_admsn_appln write)
#   DEFAULT_* -> secondary DB that receives the per-year application row
# Point these at your EXISTING ATLAS databases.
DICEAPP_DB_HOST=localhost
DICEAPP_DB_PORT=3306
DICEAPP_DB_USER=root
DICEAPP_DB_PASSWORD=
DICEAPP_DB_NAME=diceapp
DICEAPP_DB_CONNECTION_LIMIT=10

DEFAULT_DB_HOST=localhost
DEFAULT_DB_PORT=3306
DEFAULT_DB_USER=root
DEFAULT_DB_PASSWORD=
DEFAULT_DB_NAME=atlas_applications
DEFAULT_DB_CONNECTION_LIMIT=10

# ================= Uploads =================
UPLOAD_DIR=uploads

# ================= Amazon S3 (document storage) =================
# NOTE: the keys hard-coded in the old PHP are exposed and should be rotated.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=dice-admissions

# ================= Email =================
# SendGrid SMTP (user is literally "apikey"; password is the API key).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SENDGRID_API_KEY=
# ERP mailer endpoint tried first (autoEmail). Optional session cookie it needs.
ERP_MAIL_URL=https://atlasskilltech.app/erp/MasterMail/send
ERP_MAIL_COOKIE=
# Chromium used to render the application PDF (defaults to the cloud image path).
CHROMIUM_PATH=/opt/pw-browsers/chromium

# ================= SMS (MSG91) =================
MSG91_AUTHKEY=
MSG91_FLOW_ID=618ba2c0ca875b601c4fe9a3
MSG91_SENDER=ATLASU

# ================= reCAPTCHA =================
# Left bypassed by default to match the original doAdmission(); set STRICT=1 to enforce.
RECAPTCHA_SECRET=
RECAPTCHA_STRICT=0
